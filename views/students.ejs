<!DOCTYPE html>
<html>
<head>
    <title>Student Details</title>
    <style>
        table {
            border-collapse: collapse;
            width: 60%;
        }
        th, td {
            border: 1px solid black;
            padding: 10px;
            text-align: center;
        }
        th {
            background-color: lightblue;
        }
    </style>
</head>
<body>
    <h2>MCA Student Details</h2>
    <table>
        <tr>
            <th>Register Number</th>
            <th>Name</th>
            <th>CGPA</th>
        </tr>
        <% students.forEach(function(student) { %>
            <tr>
                <td><%= student.regno %></td>
                <td><%= student.name %></td>
                <td><%= student.CGPA %></td>
            </tr>
        <% }); %>
    </table>     </body>     </html>
